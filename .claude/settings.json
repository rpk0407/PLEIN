{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check:feed)",
      "Bash(npm run releve *)",
      "Bash(npm run audit *)",
      "Bash(npm run vigie *)",
      "Bash(npm run prix *)",
      "Bash(npm run plein *)",
      "Bash(npm run ticket *)",
      "Bash(npm run verify:ticket *)",
      "Bash(node --test test/no-signing.test.mjs)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "PowerShell(npm test)",
      "PowerShell(npm run check:feed)",
      "PowerShell(npm run releve *)",
      "PowerShell(npm run audit *)",
      "PowerShell(npm run vigie *)",
      "PowerShell(npm run prix *)",
      "PowerShell(npm run plein *)",
      "PowerShell(npm run ticket *)",
      "PowerShell(npm run verify:ticket *)",
      "PowerShell(node --test test/no-signing.test.mjs)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git blame *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh workflow list *)",
      "PowerShell(gh workflow view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow disable *)",
      "Bash(gh workflow enable *)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(node scripts/telegram.mjs *)",
      "Bash(npm run telegram *)",
      "Bash(node scripts/totem.mjs *--post*)",
      "Bash(npm run totem *--post*)",
      "Bash(npm run prix *--write*)",
      "Bash(node scripts/official-price.mjs *--write*)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh workflow disable *)",
      "PowerShell(gh workflow enable *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh api *)",
      "PowerShell(gh repo *)",
      "PowerShell(node scripts/telegram.mjs *)",
      "PowerShell(npm run telegram *)",
      "PowerShell(node scripts/totem.mjs *--post*)",
      "PowerShell(npm run totem *--post*)",
      "PowerShell(npm run prix *--write*)",
      "PowerShell(node scripts/official-price.mjs *--write*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/id.json)",
      "Read(**/*keypair*.json)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/id.json)",
      "Read(//**/*keypair*.json)",
      "Read(//**/*.key)",
      "Read(//**/*.pem)",
      "Read(~/.config/solana/**)",
      "Read(~/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/id.json)",
      "Edit(**/*keypair*.json)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Bash(solana *)",
      "Bash(solana-*)",
      "Bash(spl-token *)",
      "Bash(spl-*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete *)",
      "Bash(gh pr review *)",
      "Bash(* --node-options*)",
      "Bash(* --import*)",
      "Bash(* --require*)",
      "PowerShell(solana *)",
      "PowerShell(solana-*)",
      "PowerShell(spl-token *)",
      "PowerShell(spl-*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push +*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * --delete *)",
      "PowerShell(gh pr review *)",
      "PowerShell(* --node-options*)",
      "PowerShell(* --import*)",
      "PowerShell(* --require*)"
    ]
  }
}
